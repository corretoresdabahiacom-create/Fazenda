rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // HELPER FUNCTIONS
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        (userId == "fazenda_shared_production_db_v1" && request.auth.token.email_verified == true && (request.auth.token.email == "admin@fazenda.com.br" || request.auth.token.email == "usuario@fazenda.com.br"))
      );
    }

    function canWrite(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        (userId == "fazenda_shared_production_db_v1" && request.auth.token.email_verified == true && request.auth.token.email == "admin@fazenda.com.br")
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // -------------------------------------------------------------------------
    // VALIDATION HELPERS
    // -------------------------------------------------------------------------

    function isBootstrapAdminEmail() {
      return isSignedIn() && request.auth.token.email in
        ['admin@fazenda.com.br', 'admmeuarmazem@gmail.com', 'arnaldolima.adv79@gmail.com'];
    }

    function isValidUser(data) {
      return data.farmName is string && data.farmName.size() <= 200
          && data.city is string && data.city.size() <= 200
          && data.role is string && data.role in ['admin', 'user']
          && (!('customExpenseTypes' in data) || data.customExpenseTypes is list)
          && (!('farmMapUrl' in data) || data.farmMapUrl is string)
          && (!('farmMapFileName' in data) || data.farmMapFileName is string)
          && (!('concludedObligations' in data) || data.concludedObligations is list);
    }

    function isValidAnimal(data) {
      return data.id is string
          && data.type is string
          && data.category is string
          && data.quantity is number && data.quantity >= 0
          && data.lotName is string && data.lotName.size() <= 100
          && data.entryDate is string
          && data.currentPastureId is string
          && data.averageWeight is number && data.averageWeight >= 0
          && data.costs is number && data.costs >= 0;
    }

    function isValidPasture(data) {
      return data.id is string
          && data.number is string
          && data.name is string && data.name.size() <= 100
          && data.grassTypes is list
          && data.capacityAguas is number && data.capacityAguas >= 0
          && data.capacitySeca is number && data.capacitySeca >= 0
          && data.size is number && data.size >= 0;
    }

    function isValidExpense(data) {
      return data.id is string
          && data.date is string
          && data.type is string
          && data.description is string && data.description.size() <= 200
          && data.value is number && data.value >= 0;
    }

    function isValidPayment(data) {
      return data.id is string
          && data.date is string
          && data.employeeName is string && data.employeeName.size() <= 100
          && data.role is string
          && data.paymentType is string
          && data.totalValue is number && data.totalValue >= 0;
    }

    function isValidTask(data) {
      return data.id is string
          && data.title is string && data.title.size() <= 200
          && data.dueDate is string
          && data.completed is bool
          && data.priority is string;
    }

    function isValidTransaction(data) {
      return data.id is string
          && data.date is string
          && data.animalId is string
          && data.type is string
          && data.quantity is number && data.quantity >= 0
          && data.price is number && data.price >= 0;
    }

    function isValidInventory(data) {
      return data.id is string
          && data.name is string && data.name.size() <= 100
          && data.category is string
          && data.quantity is number && data.quantity >= 0
          && data.unit is string
          && data.lastUpdated is string;
    }

    function isValidEmployee(data) {
      return data.id is string
          && data.name is string && data.name.size() <= 150
          && data.role is string
          && data.status is string
          && data.admissionDate is string;
    }

    function isValidFixedExpense(data) {
      return data.id is string
          && data.description is string && data.description.size() <= 200
          && data.dueDate is string
          && data.value is number && data.value >= 0
          && data.expenseType is string;
    }

    function isValidWeighingSheet(data) {
      return data.id is string
          && data.name is string && data.name.size() <= 100
          && data.date is string
          && data.rows is list
          && (!('notes' in data) || data.notes is string);
    }

    function isValidProperty(data) {
      return data.id is string
          && data.name is string && data.name.size() <= 200
          && data.type is string
          && data.createdAt is string;
    }

    function isValidIndividualAnimal(data) {
      return data.id is string
          && data.earTag is string && data.earTag.size() <= 50
          && data.sex is string
          && data.category is string
          && data.status is string
          && data.createdAt is string;
    }

    function isValidReproductionEvent(data) {
      return data.id is string
          && data.animalEarTag is string
          && data.type is string
          && data.date is string;
    }

    function isValidHealthEvent(data) {
      return data.id is string
          && data.animalEarTag is string
          && data.type is string
          && data.productName is string
          && data.date is string;
    }

    function isValidMilkRecord(data) {
      return data.id is string
          && data.date is string
          && data.period is string
          && data.liters is number && data.liters >= 0;
    }

    // Fase 3/4 (Agricultura) — validação mínima de propósito: o app garante
    // que todo registro sempre chega com um valor padrão sensato em cada
    // campo (mesmo que o usuário deixe em branco na tela), então aqui só
    // confirmamos que existe um id válido, sem exigir mais nada.
    function isValidAgricultureRecord(data) {
      return data.id is string;
    }

    // Fase 9 (Financeiro, Maquinas, RH Rural) — mesma filosofia: o app
    // sempre garante um id válido; nenhum outro campo é obrigatório.
    function isValidFase9Record(data) {
      return data.id is string;
    }

    // -------------------------------------------------------------------------
    // MATCH BLOCKS
    // -------------------------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if canWrite(userId) && isValidUser(incoming())
          && (
            (isBootstrapAdminEmail() && incoming().role == 'admin') ||
            (!isBootstrapAdminEmail() && incoming().role == 'user')
          );
      // Numa atualização normal, o papel do usuário nunca pode mudar — isso
      // impede que alguém se autopromova a admin reescrevendo o próprio
      // documento pelo console do navegador. Trocar de papel exige edição
      // manual direto no Firebase Console (aceitável para o tamanho atual
      // do projeto, sem custo de Cloud Functions).
      //
      // Exceção: contas que já existiam ANTES desta funcionalidade (o
      // documento já tinha farmName/city salvos, mas nunca teve "role")
      // podem definir o papel pela primeira vez, seguindo a mesma regra de
      // bootstrap usada na criação — sem isso, contas antigas ficavam
      // travadas em "user" para sempre, mesmo sendo e-mail de admin.
      allow update: if canWrite(userId) && isValidUser(incoming())
          && (
            incoming().role == resource.data.role
            || (
              !('role' in resource.data) &&
              (
                (isBootstrapAdminEmail() && incoming().role == 'admin') ||
                (!isBootstrapAdminEmail() && incoming().role == 'user')
              )
            )
          );

      match /animals/{animalId} {
        allow list, get: if isOwner(userId);
        allow create: if canWrite(userId) && isValidId(animalId) && isValidAnimal(incoming());
        allow update: if canWrite(userId) && isValidAnimal(incoming());
        allow delete: if canWrite(userId);
      }

      match /pastures/{pastureId} {
        allow list, get: if isOwner(userId);
        allow create: if canWrite(userId) && isValidId(pastureId) && isValidPasture(incoming());
        allow update: if canWrite(userId) && isValidPasture(incoming());
        allow delete: if canWrite(userId);
      }

      match /expenses/{expenseId} {
        allow list, get: if isOwner(userId);
        allow create: if canWrite(userId) && isValidId(expenseId) && isValidExpense(incoming());
        allow update: if canWrite(userId) && isValidExpense(incoming());
        allow delete: if canWrite(userId);
      }

      match /payments/{paymentId} {
        allow list, get: if isOwner(userId);
        allow create: if canWrite(userId) && isValidId(paymentId) && isValidPayment(incoming());
        allow update: if canWrite(userId) && isValidPayment(incoming());
        allow delete: if canWrite(userId);
      }

      match /tasks/{taskId} {
        allow list, get: if isOwner(userId);
        allow create: if canWrite(userId) && isValidId(taskId) && isValidTask(incoming());
        allow update: if canWrite(userId) && isValidTask(incoming());
        allow delete: if canWrite(userId);
      }

      match /transactions/{transactionId} {
        allow list, get: if isOwner(userId);
        allow create: if canWrite(userId) && isValidId(transactionId) && isValidTransaction(incoming());
        allow update: if canWrite(userId) && isValidTransaction(incoming());
        allow delete: if canWrite(userId);
      }

      match /inventory/{itemId} {
        allow list, get: if isOwner(userId);
        allow create: if canWrite(userId) && isValidId(itemId) && isValidInventory(incoming());
        allow update: if canWrite(userId) && isValidInventory(incoming());
        allow delete: if canWrite(userId);
      }

      match /employees/{employeeId} {
        allow list, get: if isOwner(userId);
        allow create: if canWrite(userId) && isValidId(employeeId) && isValidEmployee(incoming());
        allow update: if canWrite(userId) && isValidEmployee(incoming());
        allow delete: if canWrite(userId);
      }

      match /fixedExpenses/{fixedExpenseId} {
        allow list, get: if isOwner(userId);
        allow create: if canWrite(userId) && isValidId(fixedExpenseId) && isValidFixedExpense(incoming());
        allow update: if canWrite(userId) && isValidFixedExpense(incoming());
        allow delete: if canWrite(userId);
      }

      match /weighingSheets/{sheetId} {
        allow list, get: if isOwner(userId);
        allow create: if canWrite(userId) && isValidId(sheetId) && isValidWeighingSheet(incoming());
        allow update: if canWrite(userId) && isValidWeighingSheet(incoming());
        allow delete: if canWrite(userId);
      }

      match /properties/{propertyId} {
        allow list, get: if isOwner(userId);
        allow create: if canWrite(userId) && isValidId(propertyId) && isValidProperty(incoming());
        allow update: if canWrite(userId) && isValidProperty(incoming());
        allow delete: if canWrite(userId);
      }

      match /individualAnimals/{animalId} {
        allow list, get: if isOwner(userId);
        allow create: if canWrite(userId) && isValidId(animalId) && isValidIndividualAnimal(incoming());
        allow update: if canWrite(userId) && isValidIndividualAnimal(incoming());
        allow delete: if canWrite(userId);
      }

      match /reproductionEvents/{eventId} {
        allow list, get: if isOwner(userId);
        allow create: if canWrite(userId) && isValidId(eventId) && isValidReproductionEvent(incoming());
        allow update: if canWrite(userId) && isValidReproductionEvent(incoming());
        allow delete: if canWrite(userId);
      }

      match /healthEvents/{eventId} {
        allow list, get: if isOwner(userId);
        allow create: if canWrite(userId) && isValidId(eventId) && isValidHealthEvent(incoming());
        allow update: if canWrite(userId) && isValidHealthEvent(incoming());
        allow delete: if canWrite(userId);
      }

      match /milkRecords/{recordId} {
        allow list, get: if isOwner(userId);
        allow create: if canWrite(userId) && isValidId(recordId) && isValidMilkRecord(incoming());
        allow update: if canWrite(userId) && isValidMilkRecord(incoming());
        allow delete: if canWrite(userId);
      }

      match /talhoes/{talhaoId} {
        allow list, get: if isOwner(userId);
        allow create: if canWrite(userId) && isValidId(talhaoId) && isValidAgricultureRecord(incoming());
        allow update: if canWrite(userId) && isValidAgricultureRecord(incoming());
        allow delete: if canWrite(userId);
      }

      match /cropPlans/{planId} {
        allow list, get: if isOwner(userId);
        allow create: if canWrite(userId) && isValidId(planId) && isValidAgricultureRecord(incoming());
        allow update: if canWrite(userId) && isValidAgricultureRecord(incoming());
        allow delete: if canWrite(userId);
      }

      match /fieldLogEntries/{entryId} {
        allow list, get: if isOwner(userId);
        allow create: if canWrite(userId) && isValidId(entryId) && isValidAgricultureRecord(incoming());
        allow update: if canWrite(userId) && isValidAgricultureRecord(incoming());
        allow delete: if canWrite(userId);
      }

      match /pestRecords/{pestId} {
        allow list, get: if isOwner(userId);
        allow create: if canWrite(userId) && isValidId(pestId) && isValidAgricultureRecord(incoming());
        allow update: if canWrite(userId) && isValidAgricultureRecord(incoming());
        allow delete: if canWrite(userId);
      }

      match /irrigationRecords/{recordId} {
        allow list, get: if isOwner(userId);
        allow create: if canWrite(userId) && isValidId(recordId) && isValidAgricultureRecord(incoming());
        allow update: if canWrite(userId) && isValidAgricultureRecord(incoming());
        allow delete: if canWrite(userId);
      }
    
      match /costCenters/{costCenterId} {
        allow list, get: if isOwner(userId);
        allow create: if canWrite(userId) && isValidId(costCenterId) && isValidFase9Record(incoming());
        allow update: if canWrite(userId) && isValidFase9Record(incoming());
        allow delete: if canWrite(userId);
      }

      match /accountsPayable/{accountId} {
        allow list, get: if isOwner(userId);
        allow create: if canWrite(userId) && isValidId(accountId) && isValidFase9Record(incoming());
        allow update: if canWrite(userId) && isValidFase9Record(incoming());
        allow delete: if canWrite(userId);
      }

      match /accountsReceivable/{accountId} {
        allow list, get: if isOwner(userId);
        allow create: if canWrite(userId) && isValidId(accountId) && isValidFase9Record(incoming());
        allow update: if canWrite(userId) && isValidFase9Record(incoming());
        allow delete: if canWrite(userId);
      }

      match /machines/{machineId} {
        allow list, get: if isOwner(userId);
        allow create: if canWrite(userId) && isValidId(machineId) && isValidFase9Record(incoming());
        allow update: if canWrite(userId) && isValidFase9Record(incoming());
        allow delete: if canWrite(userId);
      }

      match /maintenanceRecords/{maintId} {
        allow list, get: if isOwner(userId);
        allow create: if canWrite(userId) && isValidId(maintId) && isValidFase9Record(incoming());
        allow update: if canWrite(userId) && isValidFase9Record(incoming());
        allow delete: if canWrite(userId);
      }

      match /teams/{teamId} {
        allow list, get: if isOwner(userId);
        allow create: if canWrite(userId) && isValidId(teamId) && isValidFase9Record(incoming());
        allow update: if canWrite(userId) && isValidFase9Record(incoming());
        allow delete: if canWrite(userId);
      }

      match /workSchedules/{schedId} {
        allow list, get: if isOwner(userId);
        allow create: if canWrite(userId) && isValidId(schedId) && isValidFase9Record(incoming());
        allow update: if canWrite(userId) && isValidFase9Record(incoming());
        allow delete: if canWrite(userId);
      }

      match /trainings/{trainId} {
        allow list, get: if isOwner(userId);
        allow create: if canWrite(userId) && isValidId(trainId) && isValidFase9Record(incoming());
        allow update: if canWrite(userId) && isValidFase9Record(incoming());
        allow delete: if canWrite(userId);
      }

      match /ppeItems/{ppeId} {
        allow list, get: if isOwner(userId);
        allow create: if canWrite(userId) && isValidId(ppeId) && isValidFase9Record(incoming());
        allow update: if canWrite(userId) && isValidFase9Record(incoming());
        allow delete: if canWrite(userId);
      }

      match /certifications/{certId} {
        allow list, get: if isOwner(userId);
        allow create: if canWrite(userId) && isValidId(certId) && isValidFase9Record(incoming());
        allow update: if canWrite(userId) && isValidFase9Record(incoming());
        allow delete: if canWrite(userId);
      }

      match /documents/{docId} {
        allow list, get: if isOwner(userId);
        allow create: if canWrite(userId) && isValidId(docId) && isValidFase9Record(incoming());
        allow update: if canWrite(userId) && isValidFase9Record(incoming());
        allow delete: if canWrite(userId);
      }
    }
  }
}
